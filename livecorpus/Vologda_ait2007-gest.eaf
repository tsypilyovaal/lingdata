        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>поэтому она типа всё ко мне</ANNOTATION_VALUE>
