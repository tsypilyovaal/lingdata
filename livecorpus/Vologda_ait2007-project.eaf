        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2324" ANNOTATION_REF="a2319">
                <ANNOTATION_VALUE>хотим им собаку, но бабушка сказала что пока (и должно быть "нет")</ANNOTATION_VALUE>
