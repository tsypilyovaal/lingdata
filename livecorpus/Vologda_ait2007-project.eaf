        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1620" ANNOTATION_REF="a1617">
                <ANNOTATION_VALUE>не "помощь в речи", потому что запнулась </ANNOTATION_VALUE>
